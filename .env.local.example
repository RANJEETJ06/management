# Copy this file to .env.local and fill in the values from your Supabase project.
# Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public site URL — used for OAuth redirects.
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — required for the team invite API (/api/invite) to send emails
# and attach existing users to a workspace. NEVER expose this to the browser.
# Settings -> API -> service_role key in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
